# ════════════════════════════════════════════════════════════════════
#  Imagen "todo en uno": nginx + la API de Node en un solo contenedor.
#
#  Motivo: con dos contenedores, nginx tiene que localizar a la API por
#  el DNS interno de Docker (juegos-api:3000). Si CasaOS no los pone en
#  la misma red definida por el usuario, ese nombre no resuelve y todas
#  las llamadas a /api/ devuelven 502. Metiéndolos en el mismo contenedor
#  se habla por 127.0.0.1 y esa clase de problema desaparece entera.
#
#  Ventaja añadida: este contenedor se comporta igual en cualquier
#  máquina, así que lo que se prueba en local es lo que corre en el
#  servidor.
# ════════════════════════════════════════════════════════════════════

FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx supervisor wget \
    && rm -rf /var/lib/apt/lists/* \
    # Debian trae un site por defecto que ocuparía el puerto 80
    && rm -f /etc/nginx/sites-enabled/default

# ── API ─────────────────────────────────────────────────────────────
WORKDIR /app
COPY api/package.json ./
RUN npm install --omit=dev
COPY api/ ./

# ── Estáticos ───────────────────────────────────────────────────────
# Se copia SOLO lo que debe servirse por web, en vez de copiar el
# repositorio entero y borrar después. Así no hay forma de que acaben
# publicados los docker-compose (que llevan el ADMIN_TOKEN), el .env,
# los Dockerfile ni la carpeta api/.
COPY index.html privacy.html ads.txt /usr/share/nginx/html/
COPY css/    /usr/share/nginx/html/css/
COPY js/     /usr/share/nginx/html/js/
COPY games/  /usr/share/nginx/html/games/
COPY data/   /usr/share/nginx/html/data/
COPY admin/  /usr/share/nginx/html/admin/

# ── Configuración ───────────────────────────────────────────────────
COPY nginx.todo-en-uno.conf /etc/nginx/conf.d/default.conf
COPY supervisord.conf       /etc/supervisor/conf.d/juegos.conf

ENV DATA_DIR=/data
VOLUME ["/data"]

EXPOSE 80

# Comprueba la cadena completa de una vez: nginx responde Y sabe llegar
# a la API por 127.0.0.1.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1/api/health || exit 1

CMD ["supervisord", "-c", "/etc/supervisor/supervisord.conf"]
