# Copia este fichero a `.env` y rellena los valores.
# `.env` está en .gitignore — NO lo commitees.

# Token de administrador para /admin/. Genera uno largo y aleatorio, p. ej.:
#   openssl rand -hex 32
# Si se deja vacío, las rutas /api/admin/* responden 503 (el panel queda cerrado).
ADMIN_TOKEN=

# Carpeta del servidor donde viven los JSON de contenido.
# Usa una RUTA ABSOLUTA: una relativa se resuelve desde donde lances
# docker-compose, y lanzarlo desde otra carpeta crearía un directorio vacío
# nuevo que parecería una pérdida de datos.
DATOS_DIR=/home/juan/juegos/datos
